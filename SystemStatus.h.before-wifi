#pragma once

#include <QObject>
#include <QVariantList>
#include <QString>

class SystemStatus : public QObject
{
    Q_OBJECT

    Q_PROPERTY(QString wifiConnection
               READ wifiConnection NOTIFY changed)

    Q_PROPERTY(bool wifiEnabled
               READ wifiEnabled NOTIFY changed)

    Q_PROPERTY(bool bluetoothEnabled
               READ bluetoothEnabled NOTIFY changed)

    Q_PROPERTY(QVariantList wifiNetworks
               READ wifiNetworks NOTIFY changed)

    Q_PROPERTY(QVariantList bluetoothDevices
               READ bluetoothDevices NOTIFY changed)

public:
    explicit SystemStatus(QObject *parent = nullptr);

    QString wifiConnection() const
    {
        return m_wifiConnection;
    }

    bool wifiEnabled() const
    {
        return m_wifiEnabled;
    }

    bool bluetoothEnabled() const
    {
        return m_bluetoothEnabled;
    }

    QVariantList wifiNetworks() const
    {
        return m_wifiNetworks;
    }

    QVariantList bluetoothDevices() const
    {
        return m_bluetoothDevices;
    }

    Q_INVOKABLE void refresh();

signals:
    void changed();

private:
    QString m_wifiConnection = "Memuat...";
    bool m_wifiEnabled = false;
    bool m_bluetoothEnabled = false;

    QVariantList m_wifiNetworks;
    QVariantList m_bluetoothDevices;
};
